# A flat node_modules (no internal .pnpm symlinks) instead of pnpm's default
# isolated store. Next's `output: "standalone"` build step copies traced
# dependency files by symlinking them, which needs elevated privileges on
# Windows without Developer Mode enabled; a flat layout has nothing to
# symlink, so the build works the same on every OS without that requirement.
# (Equivalent to the `nodeLinker: node-modules` yarn was already configured
# with before this project switched package managers.)
node-linker=hoisted
