# Base URL of the Spring Boot API, reachable from the browser
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Frontend-only mode: when false (or unset), every request that would go to
# the API above is instead answered from local mock data (see
# src/config/feature-flags.ts and src/mocks/). Set to true once a backend is
# reachable from wherever this app is deployed.
NEXT_PUBLIC_USE_API=false

# Public URL of this frontend app (used for absolute links, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. With a key the contact page uses Google's supported Maps Embed API;
# without one it falls back to the keyless embed, which needs no account but is
# undocumented. Set this for any real deployment.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Hostname serving uploaded media in production, added to next/image's allowed
# remote patterns. Without it, CMS images pointing at uploads fail to optimise.
NEXT_PUBLIC_MEDIA_HOSTNAME=
